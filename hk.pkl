amends "package://github.com/jdx/hk/releases/download/v1.36.0/hk@1.36.0#/Config.pkl"

local linters = new Mapping<String, Step> {
  ["gofmt"] {
    glob = List("cmd/**/*.go", "internal/**/*.go")
    check = "mise run fmt"
    fix = "gofmt -s -w cmd internal"
  }
  ["go-vet"] {
    glob = List("cmd/**/*.go", "internal/**/*.go")
    check = "mise run vet"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["check"] {
    steps = linters
  }
  ["fix"] {
    fix = true
    steps = linters
  }
}
